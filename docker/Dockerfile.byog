ARG BASE_IMAGE
FROM ${BASE_IMAGE}
WORKDIR /opt/vllm-byog
COPY tools tools
COPY data /opt/byog-data/gsm8k
COPY build-info.json build-info.json
ENV BYOG_DATA_DIR=/opt/byog-data/gsm8k
# The base must contain both client features; fail the build for older branches.
RUN VLLM_USE_RUST_BENCH=0 vllm bench serve --help | grep -q -- --workload \
    && vllm eval gsm8k --help >/dev/null
ENTRYPOINT ["env", "-u", "VLLM_GPU_SYNC_CHECK", "python3", "-m", "tools.byog.run"]
